APP_ENV=development
POSTGRES_DB=mes
POSTGRES_USER=mes_bootstrap
POSTGRES_PASSWORD=replace-with-local-bootstrap-password
MES_APP_PASSWORD=replace-with-local-app-password
MES_MIGRATOR_PASSWORD=replace-with-local-migrator-password
DATABASE_URL=postgresql+psycopg://mes_app:replace-with-local-app-password@db:5432/mes
MIGRATION_DATABASE_URL=postgresql+psycopg://mes_migrator:replace-with-local-migrator-password@db:5432/mes
