MES_IMAGE=ygc-mes:release
APP_PORT=8000
POSTGRES_DB=mes
POSTGRES_USER=mes_bootstrap
POSTGRES_PASSWORD=replace-with-a-unique-bootstrap-password
MES_APP_PASSWORD=replace-with-a-unique-runtime-password
MES_MIGRATOR_PASSWORD=replace-with-a-unique-migration-password
DATABASE_URL=postgresql+psycopg://mes_app:replace-with-a-unique-runtime-password@db:5432/mes
MIGRATION_DATABASE_URL=postgresql+psycopg://mes_migrator:replace-with-a-unique-migration-password@db:5432/mes
TOTP_ENCRYPTION_KEYS=copy-the-existing-encryption-keys-when-restoring-a-database
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=copy-the-access-application-audience
